# Copy to .env and edit. Environment variables override these values.

# ---- Option A: Ollama (easiest, local) ----
# 1) install: https://ollama.com
# 2) ollama pull qwen2.5:latest
# 3) make sure `ollama serve` is running (default port 11434)
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:latest

# ---- Option B: 智谱 GLM-4-Flash (免费, 国内直连, 支持工具调用) ----
# 1) https://bigmodel.cn 注册 -> API Keys
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
# LLM_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx
# LLM_MODEL=glm-4-flash


# ---- Option C: 魔搭 ModelScope 免费额度 ----
# 1) https://modelscope.cn 注册 -> 访问令牌
# LLM_API_BASE=https://api-inference.modelscope.cn/v1
# LLM_API_KEY=ms-xxxxxxxx
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---- Option D: vLLM (GPU server) ----
# python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2.5-7B-Instruct --port 8000
# LLM_API_BASE=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- Option E: OpenAI / DeepSeek cloud ----
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-chat

# ---- Vector store: faiss (default, no Docker) or milvus (Docker cluster) ----
VECTOR_STORE_TYPE=faiss

# ---- Embeddings: local (default, offline) or openai (calls LLM_API_BASE /embeddings) ----
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 模型已缓存后可跳过远端元数据探测，加快启动
# HF_HUB_OFFLINE=1

# Admin UI (/admin). Leave empty to allow loopback only.
ADMIN_TOKEN=
# Max upload size per file (MB)
MAX_UPLOAD_MB=50
# Root folder scanned by ingestion and the admin UI
DATA_DIR=./data

# ---- Optional cross-encoder reranking (downloads the model on first use) ----
# RERANK_ENABLED=true
# RERANK_MODEL=BAAI/bge-reranker-base
# English/low-latency alternative: cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=12

# /health reports "down" (HTTP 503) when fewer chunks than this are indexed.
# HEALTH_MIN_CHUNKS=1

# ---- Retrieval: hybrid (vector + BM25) ----
# HYBRID_ENABLED=true
# auto   -> server-side sparse BM25 on Milvus >= 2.5, else in-process BM25
# local  -> always in-process BM25 (works with FAISS)
# milvus -> require server-side sparse BM25; startup fails if unavailable
# HYBRID_ENGINE=auto
# Server-side BM25 needs Milvus >= 2.5 and a collection rebuilt with --reset.
# HYBRID_CANDIDATES=20
# HYBRID_MAX_DOCS=20000
# HYBRID_SPARSE_FIELD=sparse
# HYBRID_ANALYZER={"type": "chinese"}

# ---- Prometheus /metrics (empty = no auth; set to require a Bearer token) ----
# METRICS_TOKEN=
