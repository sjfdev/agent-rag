# Copy to .env and edit. Environment variables override these values.

# ---- Option A: Ollama (easiest, local) ----
# 1) install: https://ollama.com
# 2) ollama pull qwen2.5:latest
# 3) make sure `ollama serve` is running (default port 11434)
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:latest

# ---- Option B: 智谱 GLM-4-Flash (免费, 国内直连, 支持工具调用) ----
# 1) https://bigmodel.cn 注册 -> API Keys
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
# LLM_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx
# LLM_MODEL=glm-4-flash

# ---- Option C: 魔搭 ModelScope 免费额度 ----
# 1) https://modelscope.cn 注册 -> 访问令牌
# LLM_API_BASE=https://api-inference.modelscope.cn/v1
# LLM_API_KEY=ms-xxxxxxxx
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---- Option D: vLLM (GPU server) ----
# python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2.5-7B-Instruct --port 8000
# LLM_API_BASE=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- Option E: OpenAI / DeepSeek cloud ----
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-chat

# ---- Vector store: faiss (default, no Docker) or milvus (Docker cluster) ----
VECTOR_STORE_TYPE=faiss
# Milvus connection (only used when VECTOR_STORE_TYPE=milvus)
MILVUS_HOST=localhost
MILVUS_PORT=19530
# Non-empty overrides host/port, e.g. http://milvus.internal:19530
MILVUS_URI=
MILVUS_COLLECTION=enterprise_kb
# Where docker compose stores etcd/Milvus data (default: .)
DOCKER_VOLUME_DIRECTORY=.

# ---- Embeddings: local (default, offline) / openai / fake (tests only) ----
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 模型已缓存后可跳过远端元数据探测，加快启动
# HF_HUB_OFFLINE=1

# Admin UI (/admin). Leave empty to allow loopback only.
ADMIN_TOKEN=
# Max upload size per file (MB)
MAX_UPLOAD_MB=50
# Root folder scanned by ingestion and the admin UI
DATA_DIR=./data

# ---- Optional cross-encoder reranking (downloads the model on first use) ----
# RERANK_ENABLED=true
# RERANK_MODEL=BAAI/bge-reranker-base
# English/low-latency alternative: cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=12

# /health reports "down" (HTTP 503) when fewer chunks than this are indexed.
# HEALTH_MIN_CHUNKS=1

# ---- Retrieval: hybrid (vector + BM25) ----
# HYBRID_ENABLED=true
# auto   -> server-side sparse BM25 on Milvus >= 2.5, else in-process BM25
# local  -> always in-process BM25 (works with FAISS)
# milvus -> require server-side sparse BM25; startup fails if unavailable
# HYBRID_ENGINE=auto
# Server-side BM25 needs Milvus >= 2.5 and a collection rebuilt with --reset.
# HYBRID_CANDIDATES=20
# HYBRID_MAX_DOCS=20000
# HYBRID_SPARSE_FIELD=sparse
# HYBRID_ANALYZER={"type": "chinese"}

# ---- Caches (process-local, cleared on ingestion/deletion) ----
# FAQ_CACHE_ENABLED=true
# FAQ_CACHE_MAX_ENTRIES=512
# FAQ_CACHE_TTL=86400
# Set to 0 to disable the query-embedding cache
# EMBEDDING_CACHE_MAX_ENTRIES=2048

# ---- Authentication ----
# none: identity comes from the request body (legacy, optional CHAT_API_KEY)
# jwt:  a signed bearer token supplies user/depts/groups; body identity ignored
# AUTH_MODE=none
# AUTH_JWT_SECRET=change-me-to-at-least-32-characters
# AUTH_JWT_ALGORITHM=HS256
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
# AUTH_TOKEN_TTL=43200
# --- OIDC / JWKS (Keycloak, Auth0, Entra ID, Feishu OIDC, ...) ---
# When set, tokens are verified with the provider's public keys instead of
# AUTH_JWT_SECRET. Check connectivity first:
#   python scripts/check_oidc.py --self-test
#   python scripts/check_oidc.py --issuer https://idp.example.com/realms/kb
# AUTH_JWKS_URL=https://idp.example.com/realms/kb/protocol/openid-connect/certs
# AUTH_JWKS_FILE=/secrets/jwks.json
# AUTH_JWKS_CACHE_SECONDS=300
# AUTH_JWT_ALGORITHMS=RS256,RS384,RS512,ES256,ES384,ES512
# Claim mapping (dotted paths allowed).
# Keycloak example:
# AUTH_CLAIM_ROLES=realm_access.roles
# AUTH_ADMIN_ROLE=kb-admin
# AUTH_ROLE_DEPT_PREFIX=kb:dept:
# AUTH_CLAIM_GROUPS=groups
# AUTH_CLAIM_DEPTS=depts
# AUTH_CLAIM_ADMIN=admin

# ---- Optional /chat API key (ignored when AUTH_MODE=jwt) ----
# CHAT_API_KEY=

# ---- Document-level ACL (JSON file; see config/acl.example.json) ----
# ACL_ENABLED=true
# ACL_FILE=./config/acl.json

# ---- Prometheus /metrics (empty = no auth; set to require a Bearer token) ----
# METRICS_TOKEN=

# ---- Retrieval / agent tuning ----
RETRIEVAL_K=4
# LLM_TIMEOUT=30
# LLM_MAX_TOKENS=256
# LLM_MAX_RETRIES=2
# AGENT_RECURSION_LIMIT=6

# ---- Rate limiting / deadlines ----
# 0 disables. Per user_id (or forwarded IP) in a sliding 60s window.
# RATE_LIMIT_PER_MINUTE=60
# Overall request deadline in seconds (0 disables).
# CHAT_TIMEOUT=120
# Conversation context used per request; older messages are dropped silently.
# HISTORY_MAX_MESSAGES=20

# ---- Failure handling / CORS ----
# Answer from retrieved excerpts when the LLM is unreachable (default on).
# LLM_FALLBACK_ENABLED=true
# Comma-separated browser origins for /chat, /chat/stream, /info, /health.
# Empty disables CORS. The admin API additionally rejects foreign origins.
# CORS_ORIGINS=https://app.example.com

# ---- Parsing ----
# Split big tables into header-repeating blocks (0 keeps the whole sheet).
# XLSX_ROWS_PER_CHUNK=20
# CSV_ROWS_PER_CHUNK=20
# XLSX_MAX_ROWS=20000
# Structured PDF tables via pdfplumber (if installed).
# PDF_TABLES_ENABLED=true
# OCR for scanned PDFs (needs pytesseract + pdf2image + tesseract + poppler).
# OCR_ENABLED=false
# OCR_MIN_CHARS=20
# OCR_LANG=eng+chi_sim
