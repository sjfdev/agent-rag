# Copy to .env and edit. Environment variables override these values.

# ---- Option A: Ollama (easiest, local) ----
# 1) install: https://ollama.com
# 2) ollama pull qwen2.5:latest
# 3) make sure `ollama serve` is running (default port 11434)
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:latest

# ---- Option B: 智谱 GLM-4-Flash (免费, 国内直连, 支持工具调用) ----
# 1) https://bigmodel.cn 注册 -> API Keys
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
# LLM_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx
# LLM_MODEL=glm-4-flash

# ---- Option C: 魔搭 ModelScope 免费额度 ----
# 1) https://modelscope.cn 注册 -> 访问令牌
# LLM_API_BASE=https://api-inference.modelscope.cn/v1
# LLM_API_KEY=ms-xxxxxxxx
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---- Option D: vLLM (GPU server) ----
# python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2.5-7B-Instruct --port 8000
# LLM_API_BASE=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- Option E: OpenAI / DeepSeek cloud ----
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-chat

# ---- Vector store: faiss (default, no Docker) or milvus (Docker cluster) ----
VECTOR_STORE_TYPE=faiss
# Milvus connection (only used when VECTOR_STORE_TYPE=milvus)
MILVUS_HOST=localhost
MILVUS_PORT=19530
# Non-empty overrides host/port, e.g. http://milvus.internal:19530
MILVUS_URI=
MILVUS_COLLECTION=enterprise_kb
# Where docker compose stores etcd/Milvus data (default: .)
DOCKER_VOLUME_DIRECTORY=.

# ---- TLS edge (production compose only) ----
# The app is published on 127.0.0.1; clients reach it through Caddy on :443.
# A single machine has no public domain, so Caddy signs with its internal CA:
# install volumes-prod/caddy/data/caddy/pki/authorities/local/root.crt on
# clients, and put a hosts entry "<host-ip> kb.internal" on each client.
KB_SITE_ADDRESS=kb.internal
# CADDY_IMAGE=caddy:2.10.2-alpine

# ---- Embeddings: local (default, offline) / openai / fake (tests only) ----
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 模型已缓存后可跳过远端元数据探测，加快启动
# HF_HUB_OFFLINE=1

# Admin UI (/admin). Leave empty to allow loopback only.
ADMIN_TOKEN=
# Max upload size per file (MB)
MAX_UPLOAD_MB=50
# Root folder scanned by ingestion and the admin UI
DATA_DIR=./data

# ---- Backups (make backup / make restore) ----
# Timestamped archives and their .sha256 sidecars land here.
# BACKUP_DIR=./backups
# `make doctor` warns when the newest archive is older than this (days).
# BACKUP_WARN_DAYS=30
# Override the vector-store paths included in the archive (comma-separated).
# Empty auto-detects DB_PATH for FAISS or volumes{,-prod}/{milvus,etcd} for Milvus.
# BACKUP_VECTOR_PATHS=
# Daily job (scripts/daily_backup.py, installed by scripts/install_launchd.py):
# how many archives to keep and where to drop a verified extra copy. Empty
# OFFSITE_BACKUP_DIR skips the copy (local-only backups die with the disk).
# BACKUP_KEEP=14
# OFFSITE_BACKUP_DIR=/Volumes/kb-archive

# ---- Optional cross-encoder reranking (downloads the model on first use) ----
# RERANK_ENABLED=true
# RERANK_MODEL=BAAI/bge-reranker-base
# English/low-latency alternative: cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=12

# /health reports "down" (HTTP 503) when fewer chunks than this are indexed.
# HEALTH_MIN_CHUNKS=1

# /health reports "degraded" when a writable directory has less free space than
# this. 0 disables the check. Worth setting well above the size of one upload.
# HEALTH_MIN_FREE_MB=512

# ---- Retrieval: hybrid (vector + BM25) ----
# HYBRID_ENABLED=true
# auto   -> server-side sparse BM25 on Milvus >= 2.5, else in-process BM25
# local  -> always in-process BM25 (works with FAISS)
# milvus -> require server-side sparse BM25; startup fails if unavailable
# HYBRID_ENGINE=auto
# Server-side BM25 needs Milvus >= 2.5 and a collection rebuilt with --reset.
# HYBRID_CANDIDATES=20
# HYBRID_MAX_DOCS=20000
# HYBRID_SPARSE_FIELD=sparse
# HYBRID_ANALYZER={"type": "chinese"}

# ---- Caches (process-local, cleared on ingestion/deletion) ----
# FAQ_CACHE_ENABLED=true
# FAQ_CACHE_MAX_ENTRIES=512
# FAQ_CACHE_TTL=86400
# Set to 0 to disable the query-embedding cache
# EMBEDDING_CACHE_MAX_ENTRIES=2048

# ---- Authentication ----
# none: identity comes from the request body (legacy, optional CHAT_API_KEY)
# jwt:  a signed bearer token supplies user/depts/groups; body identity ignored
# AUTH_MODE=none
# AUTH_JWT_SECRET=change-me-to-at-least-32-characters
# AUTH_JWT_ALGORITHM=HS256
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
# AUTH_TOKEN_TTL=43200
# --- OIDC / JWKS (Keycloak, Auth0, Entra ID, Feishu OIDC, ...) ---
# When set, tokens are verified with the provider's public keys instead of
# AUTH_JWT_SECRET. Check connectivity first:
#   python scripts/check_oidc.py --self-test
#   python scripts/check_oidc.py --issuer https://idp.example.com/realms/kb
# AUTH_JWKS_URL=https://idp.example.com/realms/kb/protocol/openid-connect/certs
# AUTH_JWKS_FILE=/secrets/jwks.json
# AUTH_JWKS_CACHE_SECONDS=300
# AUTH_JWT_ALGORITHMS=RS256,RS384,RS512,ES256,ES384,ES512
# Claim mapping (dotted paths allowed).
# Keycloak example:
# AUTH_CLAIM_ROLES=realm_access.roles
# AUTH_ADMIN_ROLE=kb-admin
# AUTH_ROLE_DEPT_PREFIX=kb:dept:
# AUTH_CLAIM_GROUPS=groups
# AUTH_CLAIM_DEPTS=depts
# AUTH_CLAIM_ADMIN=admin
# Optional: deny a role explicitly (e.g. guests) and grant departments to
# identities whose token carries no dept claim.
# AUTH_DENY_ROLE=guest
# AUTH_DEFAULT_DEPTS=Tech
# --- OIDC browser login (authorization-code flow) ---
# With a client configured, /auth/login redirects to the IdP and /auth/callback
# hands the console a bearer token; the admin gate shows a "company login"
# button. Leave empty to disable and keep pasting tokens by hand.
# AUTH_OIDC_CLIENT_ID=agent-rag
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_AUTHORIZE_URL=https://idp.example.com/realms/kb/protocol/openid-connect/auth
# AUTH_OIDC_TOKEN_URL=https://idp.example.com/realms/kb/protocol/openid-connect/token
# AUTH_OIDC_REDIRECT_URI=https://kb.example.com/auth/callback
# AUTH_OIDC_SCOPE=openid profile
# --- Local accounts (no IdP at all) ---
# Username/password login. Requires AUTH_MODE=jwt: the endpoint mints an ordinary
# bearer token, so departments/groups/admin, caching, rate limits and audit are
# unchanged. Manage accounts with scripts/manage_users.py or the admin console.
# The users file holds password hashes and is gitignored.
# AUTH_LOCAL_LOGIN_ENABLED=true
# AUTH_USERS_FILE=./config/users.json
# AUTH_LOCAL_TOKEN_TTL=28800
# Login attempts per client IP per minute (0 disables).
# AUTH_LOGIN_RATE_LIMIT=10

# ---- Optional /chat API key (ignored when AUTH_MODE=jwt) ----
# CHAT_API_KEY=

# ---- Offline license (private deployments; see src/license.py) ----
# Disabled for development. When enabled, a missing/forged license refuses
# startup; an expired one keeps chat answering and only blocks admin writes
# (ingestion, uploads, model changes) after LICENSE_GRACE_DAYS.
# Issue one with: python scripts/issue_license.py --licensee "ACME" --days 365
# 30-day evaluation: python scripts/issue_license.py --trial --licensee "ACME"
# LICENSE_ENABLED=true
# LICENSE_FILE=./config/license.json
# Vendor public key override (base64 raw 32 bytes or PEM). Empty uses the key
# compiled into src/license.py.
# LICENSE_PUBLIC_KEY=
# LICENSE_GRACE_DAYS=14
# LICENSE_WARN_DAYS=30

# ---- Document-level ACL (JSON file; see config/acl.example.json) ----
# FAILS CLOSED: when enabled, a missing/invalid file makes the app refuse to
# start (and /health report down) rather than serving every document.
# ACL_ENABLED=true
# ACL_FILE=./config/acl.json

# ---- Prometheus /metrics (empty = no auth; set to require a Bearer token) ----
# When METRICS_TOKEN is set, also write it to
# monitoring/prometheus/metrics_token and uncomment the authorization block in
# monitoring/prometheus/prometheus.yml.
# METRICS_TOKEN=

# ---- Monitoring overlay (docker-compose.monitoring.yml) ----
# Change the Grafana password before exposing :3000 beyond loopback.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# PROMETHEUS_RETENTION=15d
# ALERTMANAGER_PORT=9093

# Alert delivery (all optional; with none set alerts have no destination).
# `make monitor-config` renders monitoring/alertmanager/alertmanager.yml from
# these values and `make monitor-up` refreshes it before starting containers.
# Email needs a smarthost; put the password in the gitignored
# monitoring/alertmanager/smtp_password instead of here.
# ALERTMANAGER_EMAIL_TO=oncall@example.com
# ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
# ALERTMANAGER_SMTP_FROM=agent-rag@example.com
# ALERTMANAGER_SMTP_AUTH_USERNAME=agent-rag@example.com
# ALERTMANAGER_SMTP_REQUIRE_TLS=true
# ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERTMANAGER_SLACK_CHANNEL=#alerts
# ALERTMANAGER_WEBHOOK_URL=https://example.com/hooks/agent-rag-alerts
# Grouping / repeat tuning (defaults shown).
# ALERTMANAGER_GROUP_WAIT=30s
# ALERTMANAGER_GROUP_INTERVAL=5m
# ALERTMANAGER_REPEAT_INTERVAL=4h

# Logs: Promtail ships agent-rag-* container stdout to Loki, Grafana queries it.
# LOKI_PORT=3100
# How long Loki keeps logs (compactor deletes older chunks).
# LOKI_RETENTION=720h
# Override when the Docker socket / json-file logs are not at the defaults
# (rootless Docker, Docker Desktop, colima, a remote daemon...).
# DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_CONTAINERS_DIR=/var/lib/docker/containers

# ---- Retrieval / agent tuning ----
RETRIEVAL_K=4
# LLM_TIMEOUT=30
# LLM_MAX_TOKENS=256
# Default sampling temperature for chat generation.
# LLM_TEMPERATURE=0.0
# Admin-console overrides (API base/model/key/temperature/max_tokens) are
# persisted here; delete the file to fall back to the values above.
# MODEL_SETTINGS_FILE=./config/model_settings.json
# 对话生成的默认采样温度（默认 0.0）。
# LLM_TEMPERATURE=0.0
# 管理台覆盖项（API Base/模型/Key/temperature/max_tokens）持久化到该文件；
# 删除文件即回退到上面的 `.env` 默认值。
# MODEL_SETTINGS_FILE=./config/model_settings.json
# LLM_MAX_RETRIES=2
# AGENT_RECURSION_LIMIT=6

# ---- Rate limiting / deadlines ----
# 0 disables. Per user_id (or forwarded IP) in a sliding 60s window.
# RATE_LIMIT_PER_MINUTE=60
# Overall request deadline in seconds (0 disables).
# CHAT_TIMEOUT=120
# Conversation context used per request; older messages are dropped silently.
# HISTORY_MAX_MESSAGES=20

# ---- Server-side sessions (POST /sessions + ChatRequest.session_id) ----
# The SQLite file lives under logs/ so it is already mounted and backed up.
# SESSIONS_ENABLED=true
# SESSIONS_DB_PATH=./logs/sessions.db
# Fold older turns into a running summary (one extra LLM call per window).
# SESSION_SUMMARY_ENABLED=true
# SESSION_SUMMARY_MAX_TOKENS=256
# SESSION_SUMMARY_MAX_CHARS=1200
# Do not retry a failed summary for this many seconds.
# SESSION_SUMMARY_RETRY_SECONDS=60

# ---- Failure handling / CORS ----
# Answer from retrieved excerpts when the LLM is unreachable (default on).
# LLM_FALLBACK_ENABLED=true
# Comma-separated browser origins for /chat, /chat/stream, /info, /health.
# Empty disables CORS. The admin API additionally rejects foreign origins.
# CORS_ORIGINS=https://app.example.com

# ---- Chunking ----
# Token window for the token-aware splitter. The default fits
# bge-small-zh-v1.5's 512-token limit (Chinese is ~1 character per token) while
# leaving room for the title prefix. The admin console can override these at
# runtime; changing any value re-chunks indexed documents on the next ingestion.
# CHUNK_TOKENS=450
# CHUNK_OVERLAP_TOKENS=50
# Prefer Chinese punctuation boundaries (。！？；，) over hard character cuts.
# CHUNK_CHINESE_PUNCTUATION=true
# Prepend the document title to every chunk for embedding/BM25 context.
# CHUNK_TITLE_PREFIX=true
# Console overrides live here (gitignored, mode 0600, included in backups).
# CHUNK_SETTINGS_FILE=./config/chunk_settings.json

# ---- Parsing ----
# Split big tables into header-repeating blocks (0 keeps the whole sheet).
# XLSX_ROWS_PER_CHUNK=20
# CSV_ROWS_PER_CHUNK=20
# XLSX_MAX_ROWS=20000
# Structured PDF tables via pdfplumber (if installed).
# PDF_TABLES_ENABLED=true
# OCR for scanned PDFs (needs pytesseract + pdf2image + tesseract + poppler).
# OCR_ENABLED=false
# OCR_MIN_CHARS=20
# OCR_LANG=eng+chi_sim
