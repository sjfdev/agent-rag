# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Environment / local data
.env
# Runtime department uploads; the Demo fixtures under data/ stay tracked.
data/公共/
db/
volumes/
volumes-prod/
volumes-monitoring/
logs/
backups/
# Bearer token for the /metrics scrape (only needed when METRICS_TOKEN is set).
monitoring/prometheus/metrics_token
# Alertmanager config is rendered from .env: it contains SMTP/Slack secrets.
monitoring/alertmanager/alertmanager.yml
monitoring/alertmanager/alertmanager.yml.tmp
monitoring/alertmanager/smtp_password

# OS / editor
.DS_Store
.idea/

# Local account database (contains password hashes): never commit.
config/users.json
config/users.json.tmp
# Vendor license signing key and issued licenses: never commit the private key.
config/license_private.pem
config/license_private*.pem
config/license.json
licenses/
# Delivery bundles built by scripts/package_release.py.
dist/
# Real ACL rules (may name people/doc paths); the example is committed instead.
config/acl.json
config/model_settings.json
config/model_settings.json.tmp

# Local agent artifacts
agensi/
