# Public demo settings. Copy to .env.demo (gitignored) before `make demo-up`.
#
#   cp .env.demo.example .env.demo
#
# The demo deliberately disables the license, server-side sessions and the
# admin token. Never reuse these values for a customer deployment.

# --- Model (required) ---------------------------------------------------
# Any OpenAI-compatible endpoint. Use a cheap/free model for a public demo.
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_MAX_TOKENS=256
LLM_TIMEOUT=30

# --- Demo guardrails ----------------------------------------------------
# No license: the demo must start without a vendor-signed file.
LICENSE_ENABLED=false
# No identity provider: visitors may pick a department in the UI.
AUTH_MODE=none
# Do not persist visitor transcripts (the UI falls back to localStorage).
SESSIONS_ENABLED=false
HISTORY_MAX_MESSAGES=6
# Per-IP limit and a short deadline keep an open demo affordable.
RATE_LIMIT_PER_MINUTE=10
CHAT_TIMEOUT=60
# Leave empty: the admin API then only accepts loopback calls inside the
# container, so visitors cannot upload, delete or rebuild anything.
ADMIN_TOKEN=
CHAT_API_KEY=

# --- Container ----------------------------------------------------------
APP_TAG=demo
DEMO_PORT=8080
